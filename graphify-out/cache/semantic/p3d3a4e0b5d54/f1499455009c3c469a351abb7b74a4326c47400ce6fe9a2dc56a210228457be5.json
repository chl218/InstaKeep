{"nodes": [{"id": "claude_instakeep_project_guide", "label": "InstaKeep CLAUDE.md Project Guide", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_one_way_dependency", "label": "One-way Dependency instakeep -> igdl", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "igdl is a standalone download library plus console script; the app depends on it, never the reverse, keeping the library reusable."}, {"id": "claude_stdlib_only_until_setup", "label": "Stdlib-only Until Setup Passes", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modules imported before ensure_ready() (igdl.security, instakeep.__init__, bootstrap, paths) must not import instaloader/piexif because dependencies may not yet be installed; ensure_ready re-launches inside .venv."}, {"id": "claude_error_handling_policy", "label": "Error Handling Policy (describe_error / describe_unexpected)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Known instaloader errors become one line; unexpected errors keep tracebacks so bugs are visible, shown via describe_unexpected where there is no terminal."}, {"id": "claude_timing_and_estimates", "label": "Timing and Download Estimates", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_shared_store_between_processes", "label": "Window and --run Share data/instakeep.json", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two separate processes use one JSON file; Store._mutate re-reads then writes atomically (temp file + os.replace) so neither overwrites the other's results."}, {"id": "claude_atomic_store_mutate", "label": "Store._mutate Atomic Re-read/Write", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_runlock", "label": "RunLock (data/run.lock, PID + staleness)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents the window and --run from downloading at the same time."}, {"id": "claude_settings_validation", "label": "Store._clean Settings Validation against default_settings()", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unknown keys are dropped on load, so any new setting must be registered in default_settings()."}, {"id": "claude_shared_run_all", "label": "runner.run_all Shared by Window and --run", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One user failing doesn't stop others; rate-limit (exit 4) ends the run; injectable build_loader/download_user/describe_error enable fakes in tests."}, {"id": "claude_gui_threading_model", "label": "GUI Worker Thread + App.messages Queue", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worker never touches widgets; posts log/pause/user_done/done tuples drained by _poll_messages every 100 ms on the Tk thread, since tkinter is not thread-safe."}, {"id"