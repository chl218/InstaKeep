{"nodes": [{"id": "claude_instakeep_overview", "label": "InstaKeep (project guidance)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_ci_workflow", "label": "CI test workflow (Windows/Linux/macOS, Py 3.10 & 3.14)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_headless_tests", "label": "Headless tests (conftest hides Tk, dialogs fixture)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creating many tk.Tk() roots in one process fails on Windows, so window tests share one session root and each gets a hidden Toplevel; tests never touch the network."}, {"id": "claude_one_way_dependency", "label": "One-way dependency instakeep -> igdl", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "igdl is a standalone download library + CLI; the app depends on it, never the reverse."}, {"id": "claude_igdl_package", "label": "igdl package (download library + CLI)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_instakeep_package", "label": "instakeep package (the app)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_pinned_posts_handling", "label": "Pinned-post handling (read limit + 3)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Profiles can pin up to 3 posts which Instagram lists first, so 3 extra posts are read and the N newest kept; videos are dropped before counting."}, {"id": "claude_stdlib_only_until_setup", "label": "Stdlib-only until setup passes", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "igdl.security, instakeep.__init__, bootstrap and paths run before dependencies are known to be installed, so they may only import the standard library; ensure_ready() relaunches inside .venv."}, {"id": "claude_error_handling_policy", "label": "Error handling policy (one-line known errors, tracebacks for bugs)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Known instaloader errors map to one line via describe_error; unexpected errors keep tracebacks (re-raised in terminal, describe_unexpected in window/--run)."}, {"id": "claude_timing_and_estimates", "label": "Timing and estimates (DownloadStats, STAT_FIELDS, estimate.py)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_shared_store_processes", "label": "Window and --run share data/instakeep.json", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two separate processes share one JSON file; Store._mutate re-reads, applies, and writes atomically (temp + os.replace) so neither overwrites the other; RunLock prevents concurrent downloads."}, {"id": "claude_atomic_mutate", "label": "Store._mutate atomic read-modify-write", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_run_lock", "label": "RunLock (data/run.lock, PID + staleness)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_settings_validation", "label": "Store._clean settings validation against default_settings()", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unknown keys are dropped on load, so any new setting must be added to default_settings()."}, {"id": "claude_shared_run_all", "label": "run_all shared by window and --run", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One user failing doesn't stop others; a rate-limit (exit 4) ends the run; injectable build_loader/download_user/describe_error allow fakes in tests."}, {"id": "claude_gui_threading", "label": "GUI threading via App.messages queue", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worker thread never touches widgets; posts log/pause/user_done/done tuples drained by _poll_messages every 100 ms on the Tk thread."}, {"id": "claude_untrusted_input", "label": "Untrusted input rules (username validation, strip_control)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_absolute_paths", "label": "Absolute paths in instakeep/paths.py", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paths are based on the file's location so the program w