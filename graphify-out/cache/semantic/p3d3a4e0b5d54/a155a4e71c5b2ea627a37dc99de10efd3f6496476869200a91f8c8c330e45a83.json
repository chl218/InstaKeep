{"nodes": [{"id": "memory_python_claude_python_guidelines", "label": "Python Guidelines for InstaKeep", "file_type": "document", "source_file": "memory/python/CLAUDE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "memory_python_claude_style_rules", "label": "Python Style Rules (future annotations, type hints, pathlib, utf-8)", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python 3.10 minimum; plain functions unless state is held; dataclasses for result records; guard clauses; comments explain why."}, {"id": "memory_python_claude_pure_helpers_separation", "label": "Pure Helpers Separate from System Calls", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Side-effect-free helpers (venv_python, in_venv, positive_int) get direct tests; system calls stay thin."}, {"id": "memory_python_claude_error_rules", "label": "Error Rules (single mapping, boundary catches with noqa reason)", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Broad exceptions caught only at boundaries where failure must reach the user; every noqa carries a reason; exit codes never renumbered because README documents them."}, {"id": "memory_python_claude_untrusted_input_rules", "label": "Untrusted Input Rules (validate, strip_control, no shell=True)", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Username validation rules out ../ path traversal; strip_control prevents terminal escape injection via captions; subprocess only with argument lists."}, {"id": "memory_python_claude_rate_limit_rules", "label": "Network and Rate Limit Rules", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No login/credentials; leave rate limiting to instaloader RateController, only make pauses visible (format_pause) and stoppable (should_stop), never shorten them."}, {"id": "memory_python_claude_should_stop", "label": "should_stop() Checks Between Posts and Users", "file_type": "concept", "source_file": "memory/python/CLAUDE.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "memory_python_claude_shared_state_rules", "label": "Shared State and Thread Rules", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Change the JSON only via Store methods, don't cache settings past one operation, call store.reload() after a run, wrap downloads in RunLock, worker never touches tk vars."}, {"id": "memory_python_claude_startup_constraint", "label": "Startup Constraint (stdlib-only modules)", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "memory_python_claude_test_rules", "label": "Test Rules (pytest, fakes, tmp_path, headless, real JPEGs)", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never hit the network; inject fakes via run_all params; use tmp_path; test EXIF against real JPEGs; add tests whenever behavior changes."}, {"id": "memory_python_claude_dependency_policy", "label": "Dependency Policy (instaloader + piexif only)", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer the standard library; adding a runtime dep requires updating pyproject.toml, bootstrap.REQUIRED_MODULES and the README setup table."}], "edges": [{"source": "memory_python_claude_python_guidelines", "target": "claude_instakeep_project_guide", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "memory/python/CLAUDE.md", "source_location": "L3", "weight": 1.0}, {"source": "memory_python_claude_python_guidelines", "target": "memory_python_claude_style_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "memory/python/CLAUDE.md", "source_location": "L5", "weight": 1.0}, {"source": "memory_python_claude_style_rules", "target": "memory_python_claude_pure_helpers_separation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "memory/python/CLAUDE.md", "source_location": "L10", "weight": 1.0}, {"source": "memory_python_claude_python_guidelines", "target": "memory_python_claude_error_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "memory/python/CLAUDE.md", "source_location": "L16", "weight": 1.0}, {"source": "memory_python_claude_python_guidelines", "target": "memory_python_claude_untrusted_input_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "memory/python/CLAUDE.md", "source_location": "L24", "weight": 1.0}, {"source": "memory_python_claude_python_guidelines", "target": "memory_python_claude_rate_limit_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "memory/python/CLAUDE.md", "source_location": "L32", "weight": 1.0}, {"source": "memory_python_claude_rate_