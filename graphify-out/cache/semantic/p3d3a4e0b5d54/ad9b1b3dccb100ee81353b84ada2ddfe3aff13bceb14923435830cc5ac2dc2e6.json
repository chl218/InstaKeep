{"nodes": [{"id": "memory_python_claude_python_guidelines", "label": "Python guidelines for InstaKeep", "file_type": "document", "source_file": "memory/python/CLAUDE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "memory_python_claude_style", "label": "Python style rules (future annotations, type hints, pathlib, utf-8)", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain functions by default, classes only for state; pure helpers separated from thin system calls so they can be tested directly."}, {"id": "memory_python_claude_errors", "label": "Error rules (describe_error single mapping, broad catch only at boundaries, noqa reasons)", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exit codes are documented in the README so must not be renumbered; rate-limit/connection errors stop the run because remaining users would be blocked too."}, {"id": "memory_python_claude_untrusted_input", "label": "Untrusted input rules (validate usernames, strip_control, no shell=True)", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Username check also rules out ../ path tricks; strip_control prevents captions sending terminal escape codes."}, {"id": "memory_python_claude_rate_limits", "label": "Network and rate-limit rules (no login, never skip RateController pauses)", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "InstaKeep only makes pauses visible (format_pause) and stoppable (should_stop); loops check should_stop between posts and users."}, {"id": "memory_python_claude_shared_state_threads", "label": "Shared state and thread rules (Store only, RunLock, no Tk in worker)", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Don't cache settings past one operation; call store.reload() after a run."}, {"id": "memory_python_claude_startup_constraint", "label": "Startup constraint (stdlib-only early modules)", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "memory_python_claude_test_rules", "label": "Test rules (pytest, fakes, tmp_path, headless, real JPEGs)", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "memory_python_claude_dependencies", "label": "Dependency rules (instaloader + piexif only, REQUIRED_MODULES)", "file_type": "rationale", "source_file": "memory/python/CLAUDE.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding a runtime dependency requires updating pyproject.toml, bootstrap.REQUIRED_MODULES and the README setup table; prefer the standard library."}], "edges": [{"source": "memory_python_claude_python_guidelines", "target": "claude_instakeep_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "memory/python/CLAUDE.md", "source_location": "L3", "weight": 1.0}, {"source": "memory_python_claude_errors", "target": "src_igdl_cli_describe_error", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "memory/python/CLAUDE.md", "source_location": "L18", "weight": 1.0}